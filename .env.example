# Optional: Postgres (Neon). Leave commented out to use the in-memory repository.
# DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require

# Optional: protects PATCH /api/orders/:id/status and DELETE /api/orders/:id.
