# Database connection string (Neon / Postgres)
# Leave empty or unset to use the built-in InMemory repository (default for local dev and tests)
DATABASE_URL=
# Optional Admin Token to protect PATCH /api/orders/:id/status and DELETE /api/orders/:id
# If unset, admin actions are open for development/demo ease.
ADMIN_TOKEN=

# Public application URL (defaults to window.location.origin on client, or http://localhost:3000)
NEXT_PUBLIC_APP_URL=
